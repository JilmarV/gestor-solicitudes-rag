# Copia este archivo como app/.env y completa los valores. NUNCA subas el .env real a Git.

# --- Modelo (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave PUBLISHABLE (empieza por sb_publishable_). NUNCA la clave secret / service_role.
SUPABASE_PUBLISHABLE_KEY=

# --- Servidor MCP propio (servidor_mcp.py) ---
# stdio = la app arranca servidor_mcp.py como subproceso (valor de entrega).
# local = llama a la misma función sin MCP (solo pruebas; la interfaz muestra un aviso).
MCP_MODO=stdio

# --- Corpus / embeddings ---
CORPUS_ID=gestor-solicitudes-v1
# Opcional: revisión exacta del modelo de embeddings que imprime preparar_corpus.py.
# Si se deja vacío, la app la lee de la configuración guardada con el corpus en Supabase.
EMB_REVISION=

# --- Servidor web ---
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860

# --- Solo para pruebas sin Groq (NO es la configuración de entrega) ---
# MODO_LLM=mock
